# ==============================================================================
# DEYSLA IT Solutions - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# SMTP Email Configuration (Nodemailer)
# Server-side only: Used for Contact Us, RFQ Quotations, and Careers forms.
# Never expose these credentials in client-side bundles or public repositories.
# ------------------------------------------------------------------------------
# SMTP Server hostname (e.g., smtp.gmail.com, smtp.office365.com, smtp.zoho.com, email-smtp.us-east-1.amazonaws.com)
SMTP_HOST="smtp.example.com"

# SMTP Port (Typically 587 for STARTTLS or 465 for SSL/TLS)
SMTP_PORT="587"

# Use SSL/TLS directly (true for port 465, false for port 587/STARTTLS)
SMTP_SECURE="false"

# SMTP Username / Authenticated email address
SMTP_USER="info@deysla.com"

# SMTP Password or Provider-specific App Password (e.g., Google 16-character App Password)
SMTP_PASS="your-smtp-password-or-app-password"

# Sender header displayed in recipients' inboxes
SMTP_FROM="DEYSLA IT Solutions <info@deysla.com>"

# Primary recipient email for website enquiries, RFQ requests, and job applications
CONTACT_EMAIL="info@deysla.com"


# ------------------------------------------------------------------------------
# Frontend & Platform Environment Variables
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public base URL where this application is hosted
APP_URL="http://localhost:3000"

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform interactive maps
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# ------------------------------------------------------------------------------
# Admin Dashboard Authentication (Server-Side Only)
# ------------------------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-to-a-strong-password"
ADMIN_JWT_SECRET="replace-with-a-random-secure-secret-key"
